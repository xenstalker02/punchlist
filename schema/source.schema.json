{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xenstalker02/punchlist/schema/source.schema.json",
  "title": "Punchlist public-source catalog",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source_id", "publisher", "title", "canonical_url", "accessed_on", "citation_patterns"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "publisher": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "pattern": "^https://.+$" },
          "accessed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "citation_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
