{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xenstalker02/punchlist/schema/defect.schema.json",
  "title": "Punchlist taxonomy entry (named defect)",
  "type": "object",
  "required": ["id", "name", "category", "standard", "definition", "symptom", "detectable_from", "fix_pattern", "refs", "illustration"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "description": "Original noun phrase. Never borrowed from prior decks." },
    "category": { "enum": ["interface", "content", "behavior"] },
    "standard": { "type": "string", "description": "The positive quality this defect violates. Small fixed set per category." },
    "definition": {
      "type": "string",
      "description": "A falsifiable presence test: 'Present when ...' — answerable yes/no against a real product. If an auditor cannot answer yes/no, the definition is defective."
    },
    "symptom": { "type": "string" },
    "detectable_from": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["screenshot", "interaction", "source+rendered", "content-text"] },
      "description": "Honest inputs. An audit run refuses findings its input cannot support and reports them as not-assessed."
    },
    "fix_pattern": { "type": "string" },
    "refs": {
      "type": "object",
      "required": ["wcag", "other"],
      "additionalProperties": false,
      "properties": {
        "wcag": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "citation"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "citation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "other": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "citation"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "citation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "illustration": { "type": "string", "pattern": "^Non-evidentiary illustration: .+", "description": "A generic explanatory scenario, explicitly not evidence that the defect occurred in a real product." }
  }
}
